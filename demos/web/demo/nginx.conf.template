server {
    listen ${PORT};

    location / {
        root /usr/share/nginx/html;
        try_files $uri /index.html;
    }

    # The agent's chats API (the person's conversations), same origin as the page.
    location /chats {
        proxy_pass ${AGENT_URL}/chats;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
    }

    # The agent's AG-UI route, same origin as the page. SSE needs buffering off and a long read timeout.
    location /agui/ {
        proxy_pass ${AGENT_URL}/agui/;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $host;
        proxy_buffering off;
        proxy_cache off;
        proxy_read_timeout 600s;
    }
}
