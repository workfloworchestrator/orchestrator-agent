{
  "name": "@workfloworchestrator/wfo-chat",
  "version": "0.1.0",
  "description": "The WFO agent as a chat popup for any page: a React component over AG-UI",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/workfloworchestrator/orchestrator-agent.git",
    "directory": "demos/web"
  },
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "files": [
    "dist"
  ],
  "main": "./dist/wfo-chat.js",
  "module": "./dist/wfo-chat.js",
  "types": "./dist/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/wfo-chat.js"
    },
    "./style.css": "./dist/wfo-chat.css"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite",
    "contract": "openapi-typescript src/api/openapi.json -o src/api/openapi.ts --default-non-nullable=false && prettier --write src/api/openapi.json src/api/openapi.ts",
    "contract:pull": "curl -sfS ${AGENT_URL:-http://127.0.0.1:8085}/openapi.json -o src/api/openapi.json && npm run contract",
    "build": "vite build --mode lib && tsc -p tsconfig.build.json",
    "build:demo": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run lint && npm run format:check && npm run typecheck && npm run build"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  },
  "dependencies": {
    "@ag-ui/client": "1.0.3",
    "lucide-react": "^1.60.0",
    "react-markdown": "^10.1.0",
    "recharts": "^3.10.1",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.19.2",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "openapi-typescript": "^7.13.0",
    "prettier": "^3.9.10",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.72.0",
    "vite": "^8.3.4"
  }
}
